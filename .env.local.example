# Database
DATABASE_URL="file:./prisma/production.db"

# Мастер-админ: email этого пользователя считается «мастером» (для отправки кодов и т.д.)
# Должен совпадать с email пользователя в БД с ролью MASTER (создаётся скриптом create-admin.js)
MASTER_ADMIN_EMAIL="admin@your-domain.com"

# JWT
JWT_SECRET="your-secret-key-here"

# AWS S3
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ru-central1"
AWS_ENDPOINT="https://storage.yandexcloud.net"
S3_BUCKET="your-bucket-name"

# Email
EMAIL_HOST="smtp.yandex.ru"
EMAIL_PORT=465
EMAIL_USER="noreply@your-domain.com"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM="noreply@your-domain.com"

# Figma API (optional, for design sync / file preview)
FIGMA_ACCESS_TOKEN="your-figma-personal-access-token"

# Next.js
NEXT_PUBLIC_API_URL="https://your-domain.com"
NODE_ENV="production"
PORT=3001
